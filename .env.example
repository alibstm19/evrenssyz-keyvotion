# Keyvotion Console environment template.
# Copy to `.env` only for local experiments; the app stores settings in
# userData and secrets in the OS keystore (Windows DPAPI).
# Never commit `.env` or real values.

# Provider keys (names only — the app fills these at runtime)
KEYVOTION_OPENAI_API_KEY=
KEYVOTION_ANTHROPIC_API_KEY=
KEYVOTION_GEMINI_API_KEY=
KEYVOTION_OPENROUTER_API_KEY=

# Optional: local OpenCode server
KEYVOTION_SERVER_HOST=127.0.0.1
KEYVOTION_SERVER_PORT=51764
KEYVOTION_SERVER_PASSWORD=

# Optional: LAN remote control (off by default)
KEYVOTION_REMOTE_PORT=7788
